{
  "name": "muallimlive",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write . --ignore-unknown",
    "format:ci": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "test": "vitest run --silent=true",
    "test:watch": "vitest --silent=true",
    "test:ui": "vitest --ui --coverage --silent=true",
    "test:cov": "vitest run --coverage --silent=true",
    "test:ci": "vitest run --coverage --silent=true --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "test:e2e:start": "cross-env NODE_ENV=test next build && cross-env NODE_ENV=test next start",
    "test:e2e:data": "http-server e2e/fixtures/cdn -s --cors",
    "test:e2e:fixtures": "node scripts/fetch-e2e-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "cross-env CI=true playwright test",
    "test:e2e:install": "npx playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@next/third-parties": "^16.3.6",
    "ahooks": "^3.10.0",
    "antd": "^6.6.5",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "google-auth-library": "^11.1.0",
    "iron-session": "^9.0.1",
    "isomorphic-dompurify": "^4.3.0",
    "localforage": "^1.10.0",
    "localforage-observable": "^2.1.1",
    "lodash-es": "^4.18.1",
    "minisearch": "^7.2.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "p-limit": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-quill-new": "^3.8.3",
    "react-virtuoso": "^4.18.15",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "stemmer": "^2.0.1",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "src/locales/**/*.json": "prettier --write --plugin prettier-plugin-sort-json --json-recursive-sort",
    "*": "prettier --write --ignore-unknown",
    "*.ts?(x)": "eslint --fix"
  },
  "volta": {
    "node": "24.11.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-sort-json": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
